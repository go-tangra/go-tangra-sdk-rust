{"schema":1,"module":"paperless","display_name":"Paperless","category":"Documents","summary":"Tenant document management - categories, sharing, Tika text extraction and full-text search, with bytes in S3-compatible storage.","image":"ghcr.io/go-tangra/go-tangra-paperless","routes":{"prefixes":["/api/paperless","/m/paperless","/paperless"],"names":["paperless"]},"min_core":{"auth":"4.10.0","gateway":"4.9.0"},"bundle":{"dir":"deploy/bundle","templates":["config.yaml","policy.yaml"],"tls_hosts":["paperless-db"]},"host_inputs":[{"key":"MODULE_ADVERTISE_HOST","label":"Host name the core uses to reach this module","pattern":"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"},{"key":"MODULE_BIND_IP","label":"IP address the module's mesh ports listen on (reachable from the core)","pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$"},{"key":"VALKEY_ADDRESS","label":"Core event bus (Valkey, TLS) as host:port, reachable from this host","pattern":"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*:[1-9][0-9]{0,4}$"},{"key":"VALKEY_PASSWORD","label":"Password of the core event bus user \"paperless\"","pattern":"^[A-Za-z0-9._~+/=-]{16,128}$"},{"key":"VALKEY_CA_FILE","label":"Host file of the CA certificate (PEM) of the core event bus (mounted read-only)","pattern":"^/[A-Za-z0-9._/-]{0,254}$"}],"docs":"https://github.com/go-tangra/go-tangra-paperless#readme"}
