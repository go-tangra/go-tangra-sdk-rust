{"schema":1,"module":"scheduler","display_name":"Scheduler","category":"Operations","summary":"Central job scheduler - periodic, delayed and run-now tasks executed by the owning modules, with retries, history and live status.","image":"ghcr.io/go-tangra/go-tangra-scheduler","routes":{"prefixes":["/api/scheduler","/m/scheduler","/scheduler"],"names":["scheduler"]},"min_core":{"auth":"4.10.0","gateway":"4.9.0"},"bundle":{"dir":"deploy/bundle","templates":["config.yaml","policy.yaml"],"tls_hosts":["scheduler-db"]},"host_inputs":[{"key":"MODULE_ADVERTISE_HOST","label":"Host name the core uses to reach this module","pattern":"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"},{"key":"MODULE_BIND_IP","label":"IP address the module's mesh ports listen on (reachable from the core)","pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$"},{"key":"VALKEY_ADDRESS","label":"Core event bus (Valkey, TLS) as host:port, reachable from this host","pattern":"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*:[1-9][0-9]{0,4}$"},{"key":"VALKEY_PASSWORD","label":"Password of the core event bus user \"scheduler\"","pattern":"^[A-Za-z0-9._~+/=-]{16,128}$"},{"key":"VALKEY_CA_FILE","label":"Host file of the CA certificate (PEM) of the core event bus (mounted read-only)","pattern":"^/[A-Za-z0-9._/-]{0,254}$"}],"docs":"https://github.com/go-tangra/go-tangra-scheduler#readme"}
